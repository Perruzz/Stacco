<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget as the widget picker shows it (Android 12+), with an example day. Only views that
  RemoteViews allows: the launcher inflates this layout itself.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- An icon of its own size beside the name, as in the widget: not a compound drawable. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stat_stacco"
            android:tint="@color/widget_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The room between the heading and the day: RemoteViews has no plain View for a spacer. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:ignore="UselessLeaf" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_exit"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_time"
        android:textColor="@color/widget_on_surface"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_bank"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_preview_button"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/stamp_exit"
        android:textColor="@color/widget_on_primary"
        android:textSize="14sp" />
</LinearLayout>
